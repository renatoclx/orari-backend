# Porta em que a API sobe
PORT=3333

# Connection string do PostgreSQL (usada pelo Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/template_backend?schema=public"

# Ambiente. Com NODE_ENV=production a API exige JWT_SECRET forte e CORS_ORIGIN, e
# desliga o Swagger (ver abaixo).
# NODE_ENV=production

# Segredo de assinatura do JWT (auth). Em produção: ao menos 32 caracteres e
# diferente do exemplo. Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Validade do access token (ex.: 1h, 15m, 7d). Em produção, prefira curto (15m):
# o front renova com o refresh token.
JWT_EXPIRES_IN=15m

# Validade do refresh token (ex.: 7d, 30d). Ao usá-lo em POST /auth/refresh,
# um novo par de tokens é emitido e o refresh token usado é revogado (rotação).
JWT_REFRESH_EXPIRES_IN=7d

# Origens permitidas no CORS, separadas por vírgula (ex.: http://localhost:5173).
# Obrigatória em produção; fora dela, se não definida, libera qualquer origem.
# CORS_ORIGIN=http://localhost:5173

# Número de proxies (balanceador, nginx etc.) à frente da API, para o limite de
# tentativas do login contar o IP do cliente e não o do proxy. Sem proxy, não defina.
# TRUST_PROXY=1

# Documentação em /docs: ligada em desenvolvimento e desligada em produção.
# Defina true/false para forçar.
# SWAGGER_ENABLED=false

# Seed da empresa da plataforma e do SUPER_ADMIN inicial (npm run prisma:seed).
# Todas as rotas exigem autenticação, e só o SUPER_ADMIN cadastra empresas e
# seus primeiros usuários. Se alguma variável estiver ausente, o seed pula esta
# etapa. CNPJ válido (numérico ou alfanumérico), sem máscara; data no formato
# AAAA-MM-DD; senha de 8 a 72 caracteres.
# SEED_COMPANY_CORPORATE_REASON="Minha Empresa LTDA"
# SEED_COMPANY_CNPJ=12ABC34501DE35
# SEED_COMPANY_SUBDOMAIN=minha-empresa
# SEED_COMPANY_FOUNDATION_DATE=2020-01-01
# SEED_SUPER_ADMIN_NAME="Administrador da plataforma"
# SEED_SUPER_ADMIN_EMAIL=admin@example.com
# SEED_SUPER_ADMIN_PASSWORD=change-me-please

# Credenciais do container do docker-compose.yml (npm run db:up)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=template_backend
POSTGRES_PORT=5432

# Pasta local onde ficam os arquivos enviados (ex.: fotos de pessoas).
# Servida em /uploads. Padrão: uploads
# UPLOADS_DIR=uploads
