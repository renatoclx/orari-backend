# Modelo do arquivo .env.production (copie para .env.production no SERVIDOR e preencha).
# Nunca coloque o arquivo preenchido no Git. Ver docs/deploy.md.

NODE_ENV=production

# Domínio da API. ":80" serve só HTTP (primeiro teste por IP); com o domínio
# apontado para o servidor, o HTTPS é automático.
API_DOMAIN=api.orariapp.com.br

# Banco. Gere a senha com: openssl rand -hex 24  (só letras e números, para não
# precisar escapar na URL abaixo).
POSTGRES_USER=orari
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=orari
# O host é "db" (o nome do serviço no compose). Repita a senha acima.
DATABASE_URL=postgresql://orari:troque-por-uma-senha-forte@db:5432/orari?schema=public

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# O valor abaixo é recusado pela API em produção: troque-o por um gerado.
JWT_SECRET=change-me-gere-um-segredo-novo-antes-de-subir
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Endereço do frontend (origens separadas por vírgula).
CORS_ORIGIN=https://app.orariapp.com.br

# O Caddy é o único proxy à frente da API.
TRUST_PROXY=1

# Seed (primeiro administrador). Preencha só para rodar o seed UMA vez e depois
# apague estas linhas. Ver docs/deploy.md.
# SEED_COMPANY_CORPORATE_REASON="Orari Plataforma LTDA"
# SEED_COMPANY_CNPJ=
# SEED_COMPANY_SUBDOMAIN=orari
# SEED_COMPANY_FOUNDATION_DATE=2026-01-01
# SEED_SUPER_ADMIN_NAME="Administrador"
# SEED_SUPER_ADMIN_EMAIL=
# SEED_SUPER_ADMIN_PASSWORD=
