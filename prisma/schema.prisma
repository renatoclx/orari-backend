// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String
  password  String
  type      UserType
  companyId String
  // Profissional (People do tipo PROFESSIONAL) que este usuário representa; dá acesso à anamnese.
  peopleId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  company                   Company                    @relation(fields: [companyId], references: [id])
  people                    People?                    @relation(fields: [peopleId], references: [id])
  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]
  anamnesisTemplateVersions AnamnesisTemplateVersion[]
  anamnesisEntries          AnamnesisEntry[]

  // Parciais: um registro excluído logicamente não bloqueia o reuso do valor.
  @@unique([email], where: raw("\"deletedAt\" IS NULL"))
  // Um profissional pertence a no máximo um usuário ativo (usuários sem vínculo não conflitam).
  @@unique([peopleId], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@map("users")
}

// Sessão de refresh token (ver auth.md). Sem deletedAt: não é uma entidade de
// domínio, é revogada (revokedAt) em vez de excluída, como Notification.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  // SHA-256 do token bruto: permite localizar o registro por igualdade sem
  // guardar o valor original (o token nunca é persistido em texto puro).
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

// SUPER_ADMIN administra a plataforma (todas as empresas); ADMIN, apenas a própria empresa.
enum UserType {
  SUPER_ADMIN
  ADMIN
  USER
}

enum PeopleType {
  CLIENT
  EMPLOYEE
  PROFESSIONAL
}

enum ContactType {
  MAIN
  MESSAGE
  BRANCH
}

enum AddressType {
  MAIN
  MESSAGE
  BRANCH
}

// Mantida via seed: sem exclusão e sem deletedAt (ver docs/database.md)
model State {
  id        String    @id @default(uuid())
  name      String
  acronym   String    @unique @db.Char(2)
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  cities City[]

  @@map("states")
}

// Mantida via seed: sem exclusão e sem deletedAt (ver docs/database.md)
model City {
  id             String    @id @default(uuid())
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  stateId        String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  state     State     @relation(fields: [stateId], references: [id])
  addresses Address[]

  @@unique([name, stateId])
  @@index([stateId])
  // GIN trigram: acelera a busca parcial (LIKE '%termo%') pelo nome normalizado.
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("cities")
}

// Empresas não são excluídas, apenas inativadas (ver docs/database.md): sem deletedAt.
model Company {
  id              String    @id @default(uuid())
  corporateReason String
  fantasyName     String?
  // CPF (11) ou CNPJ (14), sem máscara. VarChar: o Char completaria o CPF com espaços.
  document        String    @unique @db.VarChar(14)
  // Opcional: não se aplica a quem usa CPF.
  foundationDate  DateTime? @db.Date
  isActive        Boolean   @default(true)
  // Fuso IANA usado para interpretar janelas de atendimento e horários de recorrência.
  timezone        String    @default("America/Sao_Paulo")
  logoUrl         String?
  subdomain       String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime?

  users                 User[]
  people                People[]
  contacts              Contact[]
  addresses             Address[]
  services              Service[]
  paymentMethods        PaymentMethod[]
  businessHours         BusinessHour[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  anamnesisTemplates    AnamnesisTemplate[]
  anamneses             Anamnesis[]
  appointments          Appointment[]
  recurringAppointments RecurringAppointment[]
  plans                 Plan[]
  payments              Payment[]
  clientPlans           ClientPlan[]
  classGroups           ClassGroup[]
  classSessions         ClassSession[]

  @@map("companies")
}

model People {
  id             String     @id @default(uuid())
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  // Opcionais: o cliente poderá se cadastrar só com nome e telefone (contato).
  document       String?    @db.Char(11)
  birthDate      DateTime?  @db.Date
  profession     String?
  type           PeopleType
  companyId      String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?
  note           String?
  // Caminho público da foto (ex.: /uploads/people/<arquivo>.jpg), preenchido pelo upload.
  photoUrl       String?

  company   Company   @relation(fields: [companyId], references: [id])
  contacts  Contact[]
  addresses Address[]

  // Uma pessoa participa dos agendamentos ora como cliente, ora como profissional.
  appointmentsAsClient        Appointment[]          @relation("AppointmentClient")
  appointmentsAsProfessional  Appointment[]          @relation("AppointmentProfessional")
  recurringAsClient           RecurringAppointment[] @relation("RecurringAppointmentClient")
  recurringAsProfessional     RecurringAppointment[] @relation("RecurringAppointmentProfessional")
  clientPlans                 ClientPlan[]
  users                       User[]
  anamnesesAsClient           Anamnesis[]            @relation("AnamnesisClient")
  anamnesisEntriesAsAuthor    AnamnesisEntry[]       @relation("AnamnesisEntryProfessional")
  classGroupsAsProfessional   ClassGroup[]
  classSessionsAsProfessional ClassSession[]

  // Parcial: um registro excluído logicamente não bloqueia o reuso do documento.
  // Pessoas sem documento não entram em conflito entre si.
  @@unique([companyId, document], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  // GIN trigram: acelera a busca parcial (LIKE '%termo%') pelo nome normalizado.
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("people")
}

// Pertence a exatamente um dono (empresa ou pessoa) e tem telefone e/ou e-mail; ambos garantidos por CHECK na migration
model Contact {
  id          String      @id @default(uuid())
  type        ContactType
  phone       String?
  email       String?
  // Contato exibido para o dono; no máximo um por dono (índices parciais abaixo).
  isPrincipal Boolean     @default(false)
  companyId   String?
  peopleId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime?
  deletedAt   DateTime?

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  people  People?  @relation(fields: [peopleId], references: [id], onDelete: Restrict)

  @@unique([companyId], where: raw("\"isPrincipal\" AND \"deletedAt\" IS NULL"), map: "contacts_principal_company_key")
  @@unique([peopleId], where: raw("\"isPrincipal\" AND \"deletedAt\" IS NULL"), map: "contacts_principal_people_key")
  @@index([companyId])
  @@index([peopleId])
  @@map("contacts")
}

// Pertence a exatamente um dono (empresa ou pessoa), garantido por CHECK na migration
model Address {
  id           String      @id @default(uuid())
  type         AddressType
  cep          String      @db.Char(8)
  street       String
  neighborhood String?
  number       String
  complement   String?
  // Endereço exibido para o dono; no máximo um por dono (índices parciais abaixo).
  isPrincipal  Boolean     @default(false)
  cityId       String
  companyId    String?
  peopleId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime?
  deletedAt    DateTime?

  city    City     @relation(fields: [cityId], references: [id])
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  people  People?  @relation(fields: [peopleId], references: [id], onDelete: Restrict)

  @@unique([companyId], where: raw("\"isPrincipal\" AND \"deletedAt\" IS NULL"), map: "addresses_principal_company_key")
  @@unique([peopleId], where: raw("\"isPrincipal\" AND \"deletedAt\" IS NULL"), map: "addresses_principal_people_key")
  @@index([cityId])
  @@index([companyId])
  @@index([peopleId])
  @@map("addresses")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Por que a clínica cancelou a aula de turma (ver docs/turmas.md). Só esses
// cancelamentos deixam a sessão de plano ser reposta; o cancelado pelo cliente, não.
enum AppointmentCancelReason {
  CLASS_SESSION_CANCELLED
  CLASS_LEFT
}

// Modalidade de pagamento de uma contratação de plano.
enum PlanBillingType {
  INTEGRAL
  MONTHLY
}

enum PaymentStatus {
  PAID
  PENDING
  CANCELLED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Service {
  id             String    @id @default(uuid())
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  description    String?
  price          Decimal?  @db.Decimal(10, 2)
  color          String?
  // Duração em minutos, usada para calcular o fim do agendamento.
  duration       Int
  companyId      String
  isActive       Boolean   @default(true)
  // Aceita atendimento em turma (ver ClassGroup).
  allowsClasses  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?

  company               Company                @relation(fields: [companyId], references: [id])
  appointments          Appointment[]
  recurringAppointments RecurringAppointment[]
  planItems             PlanItem[]
  classGroups           ClassGroup[]
  classSessions         ClassSession[]

  @@unique([companyId, name], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("services")
}

// Sem deletedAt por decisão do domínio: o ciclo de vida é controlado pelo status.
model Appointment {
  id                     String                   @id @default(uuid())
  companyId              String
  clientId               String
  professionalId         String
  serviceId              String
  startAt                DateTime
  // Calculado a partir da duração do serviço (ver AppointmentService).
  endAt                  DateTime
  note                   String?
  status                 AppointmentStatus        @default(SCHEDULED)
  // Encaixe: agendamento avulso marcado fora do horário de funcionamento. Retrato
  // do momento em que foi marcado; não é recalculado se o horário mudar depois.
  overBooking            Boolean                  @default(false)
  // Preenchido quando o agendamento foi gerado por uma recorrência.
  recurringAppointmentId String?
  // Preenchido quando o agendamento é de um aluno numa sessão de turma.
  classSessionId         String?
  // Preenchido quando a clínica cancelou a aula de turma (sessão cancelada ou saída da turma).
  cancelReason           AppointmentCancelReason?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime?

  company              Company               @relation(fields: [companyId], references: [id])
  client               People                @relation("AppointmentClient", fields: [clientId], references: [id])
  professional         People                @relation("AppointmentProfessional", fields: [professionalId], references: [id])
  service              Service               @relation(fields: [serviceId], references: [id])
  payment              Payment?
  anamnesisEntries     AnamnesisEntry[]
  recurringAppointment RecurringAppointment? @relation(fields: [recurringAppointmentId], references: [id])
  classSession         ClassSession?         @relation(fields: [classSessionId], references: [id])

  @@index([companyId, startAt])
  @@index([professionalId, startAt])
  @@index([clientId, startAt])
  @@index([status, endAt])
  @@index([serviceId])
  @@index([recurringAppointmentId])
  @@index([classSessionId])
  @@map("appointments")
}

// Sem deletedAt por decisão do domínio: não há exclusão, apenas isActive.
model RecurringAppointment {
  id             String    @id @default(uuid())
  companyId      String
  clientId       String
  professionalId String
  serviceId      String
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  note           String?
  isActive       Boolean   @default(true)
  // Preenchido quando a recorrência é a agenda de um serviço de um plano contratado.
  clientPlanId   String?
  // Turma fixa em que a recorrência está encaixada (os dias são horários dela).
  classGroupId   String?
  // Saída da turma: quando o aluno saiu e o motivo (as aulas futuras da turma foram canceladas).
  classLeftAt    DateTime?
  classLeaveNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  company      Company        @relation(fields: [companyId], references: [id])
  clientPlan   ClientPlan?    @relation(fields: [clientPlanId], references: [id], onDelete: Restrict)
  client       People         @relation("RecurringAppointmentClient", fields: [clientId], references: [id])
  professional People         @relation("RecurringAppointmentProfessional", fields: [professionalId], references: [id])
  service      Service        @relation(fields: [serviceId], references: [id])
  classGroup   ClassGroup?    @relation(fields: [classGroupId], references: [id])
  days         RecurringDay[]
  appointments Appointment[]

  @@index([companyId, isActive])
  @@index([professionalId])
  @@index([clientId])
  @@index([serviceId])
  @@index([clientPlanId])
  @@index([classGroupId])
  @@map("recurring_appointments")
}

// Pacote de serviços vendido pela empresa. O valor mensal é definido pela empresa;
// os períodos de contratação (PlanPeriod) aplicam descontos sobre ele. Não há
// exclusão: o plano é desativado por isActive.
model Plan {
  id             String    @id @default(uuid())
  companyId      String
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  description    String?
  monthlyPrice   Decimal   @db.Decimal(10, 2)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  company     Company      @relation(fields: [companyId], references: [id])
  items       PlanItem[]
  periods     PlanPeriod[]
  clientPlans ClientPlan[]

  @@unique([companyId, name])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("plans")
}

// Serviço incluído em um plano. Faz parte do plano: é criado e substituído junto
// com ele, por isso usa exclusão física (ver docs/database.md).
model PlanItem {
  id              String   @id @default(uuid())
  planId          String
  serviceId       String
  // Atendimentos por semana deste serviço no plano (1 a 7, validado no DTO).
  sessionsPerWeek Int      @default(1)
  createdAt       DateTime @default(now())

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([planId, serviceId])
  @@index([serviceId])
  @@map("plan_items")
}

// Período de contratação de um plano, com os dois percentuais de desconto. Faz
// parte do plano (exclusão física); as contratações guardam cópia dos valores.
model PlanPeriod {
  id                     String    @id @default(uuid())
  planId                 String
  months                 Int
  // Desconto para pagamento integral do período.
  discountPercent        Decimal   @db.Decimal(5, 2)
  // Desconto de cada parcela no pagamento mensal.
  monthlyDiscountPercent Decimal   @db.Decimal(5, 2)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, months])
  @@map("plan_periods")
}

// Contratação de um plano por um cliente. Os valores são congelados na
// contratação: mudar o plano ou os serviços depois não os altera. Cada serviço do
// plano vira uma recorrência própria (RecurringAppointment.clientPlanId).
model ClientPlan {
  id              String          @id @default(uuid())
  companyId       String
  clientId        String
  planId          String
  billingType     PlanBillingType
  months          Int
  // Período pelo calendário (datas puras, sem fuso).
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  // Valor mensal do plano no momento da contratação.
  monthlyAmount   Decimal         @db.Decimal(10, 2)
  // Percentual aplicado conforme a modalidade (integral ou mensal).
  discountPercent Decimal         @db.Decimal(5, 2)
  totalAmount     Decimal         @db.Decimal(10, 2)
  // Vencimento do primeiro pagamento; os seguintes vencem mês a mês.
  firstDueDate    DateTime?       @db.Date
  // Vazio enquanto a contratação está ativa; preenchido no cancelamento.
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime?

  company               Company                @relation(fields: [companyId], references: [id])
  client                People                 @relation(fields: [clientId], references: [id])
  plan                  Plan                   @relation(fields: [planId], references: [id])
  payments              Payment[]
  recurringAppointments RecurringAppointment[]

  @@index([companyId])
  @@index([clientId])
  @@index([planId])
  @@map("client_plans")
}

// Faz parte do agendamento recorrente: é criada e substituída junto com ele,
// por isso usa exclusão física (ver docs/database.md).
model RecurringDay {
  id                     String    @id @default(uuid())
  recurringAppointmentId String
  weekDay                WeekDay
  startTime              DateTime  @db.Time(0)
  endTime                DateTime  @db.Time(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime?

  recurringAppointment RecurringAppointment @relation(fields: [recurringAppointmentId], references: [id], onDelete: Cascade)

  @@index([recurringAppointmentId])
  @@map("recurring_days")
}

model PaymentMethod {
  id             String    @id @default(uuid())
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  companyId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?

  company  Company   @relation(fields: [companyId], references: [id])
  payments Payment[]

  // Único pelo nome normalizado: "PIX", "Pix" e "pix" são o mesmo método.
  @@unique([companyId, normalizedName], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("payment_methods")
}

model Payment {
  id              String        @id @default(uuid())
  // A empresa fica no próprio pagamento: os de plano não têm agendamento.
  companyId       String
  // Um pagamento é de um agendamento ou de uma contratação de plano, nunca dos dois.
  appointmentId   String?
  clientPlanId    String?
  amount          Decimal       @db.Decimal(10, 2)
  // Vencimento pelo calendário, opcional. Em agendamentos de recorrência, acompanha a data do agendamento.
  dueDate         DateTime?     @db.Date
  // Preenchido apenas quando o pagamento está PAID.
  paidAt          DateTime?
  // Opcional enquanto PENDING: o método é informado na baixa para PAID.
  paymentMethodId String?
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime?
  deletedAt       DateTime?

  company       Company        @relation(fields: [companyId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  clientPlan    ClientPlan?    @relation(fields: [clientPlanId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  // Parcial: um pagamento excluído libera o agendamento para um novo pagamento.
  @@unique([appointmentId], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@index([clientPlanId])
  @@index([paymentMethodId])
  @@map("payments")
}

// Janela de atendimento de uma empresa em um dia da semana. Uma empresa pode ter
// mais de uma janela no mesmo dia (ex.: manhã e tarde). Empresa sem nenhuma
// janela cadastrada não restringe horários (ver docs/business-rules.md).
model BusinessHour {
  id        String    @id @default(uuid())
  companyId String
  weekDay   WeekDay
  openAt    DateTime  @db.Time(0)
  closeAt   DateTime  @db.Time(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, weekDay])
  @@map("business_hours")
}

/**
 * Aviso para a empresa agir. Ainda não há tipos em uso: a entidade é mantida para
 * implementações futuras. Notificações não são excluídas: são resolvidas (ver docs/database.md).
 */
model Notification {
  id         String    @id @default(uuid())
  companyId  String
  message    String
  readAt     DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, resolvedAt])
  @@map("notifications")
}

// Ações sensíveis registradas na auditoria. Cresce junto com as funcionalidades
// que gravam o registro (a anamnese acrescentará as suas).
enum AuditAction {
  USER_LINK_CHANGED
  USER_TYPE_CHANGED
  USER_RESTORED
  ANAMNESIS_TEMPLATE_CREATED
  ANAMNESIS_TEMPLATE_UPDATED
  ANAMNESIS_VIEWED
  ANAMNESIS_LISTED
  ANAMNESIS_ENTRY_CREATED
  ANAMNESIS_PDF_GENERATED
}

/**
 * Registro de uma ação sensível: quem fez o quê, em qual alvo e quando. Só
 * recebe inserções (sem deletedAt nem updatedAt): não é alterado nem excluído
 * pela API (ver docs/database.md).
 */
model AuditLog {
  id         String      @id @default(uuid())
  companyId  String
  userId     String
  action     AuditAction
  // Tipo e código do alvo da ação (ex.: USER e o id do usuário alterado).
  entityType String
  entityId   String
  // Cliente a que a ação se refere, quando houver (sem relação: o registro vale mesmo se o cliente for removido).
  clientId   String?
  ip         String?
  createdAt  DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, clientId])
  @@map("audit_logs")
}

enum AnamnesisQuestionType {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  NUMBER
  DATE
  SCALE
}

// Modelo de ficha de anamnese da empresa. Não é excluído: é inativado (isActive).
model AnamnesisTemplate {
  id             String    @id @default(uuid())
  companyId      String
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação (ver normalizeForSearch):
  // sustenta a busca e a unicidade do nome sem diferenciar maiúsculas nem acentos.
  normalizedName String
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  company   Company                    @relation(fields: [companyId], references: [id])
  versions  AnamnesisTemplateVersion[]
  anamneses Anamnesis[]

  @@unique([companyId, normalizedName])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("anamnesis_templates")
}

// Conjunto de perguntas do modelo em um momento. Imutável: editar as perguntas
// cria a versão seguinte, sem exclusão física (as fichas ficam presas à versão).
model AnamnesisTemplateVersion {
  id          String   @id @default(uuid())
  templateId  String
  version     Int
  createdById String
  createdAt   DateTime @default(now())

  template  AnamnesisTemplate   @relation(fields: [templateId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  questions AnamnesisQuestion[]
  anamneses Anamnesis[]

  // Também barra duas edições simultâneas que gerariam o mesmo número de versão.
  @@unique([templateId, version])
  @@map("anamnesis_template_versions")
}

model AnamnesisQuestion {
  id          String                @id @default(uuid())
  versionId   String
  // Posição na lista (de 1 em diante), definida pela ordem em que o front envia as perguntas.
  position    Int
  label       String
  helpText    String?
  type        AnamnesisQuestionType
  isRequired  Boolean               @default(false)
  // Só para escolha única e múltipla; vazio nos demais tipos.
  options     String[]
  // Só para sim ou não (ex.: "Qual?").
  detailLabel String?

  version AnamnesisTemplateVersion @relation(fields: [versionId], references: [id])
  answers AnamnesisAnswer[]

  @@unique([versionId, position])
  @@map("anamnesis_questions")
}

enum AnamnesisEntryKind {
  INITIAL
  FOLLOW_UP
}

// Ficha de um cliente em um modelo: o dossiê ao qual os registros se ligam. Presa
// à versão do modelo vigente quando foi criada. Não é excluída pela API.
model Anamnesis {
  id         String   @id @default(uuid())
  companyId  String
  clientId   String
  templateId String
  versionId  String
  createdAt  DateTime @default(now())

  company  Company                  @relation(fields: [companyId], references: [id])
  client   People                   @relation("AnamnesisClient", fields: [clientId], references: [id])
  template AnamnesisTemplate        @relation(fields: [templateId], references: [id])
  version  AnamnesisTemplateVersion @relation(fields: [versionId], references: [id])
  entries  AnamnesisEntry[]

  // Uma ficha por cliente e por modelo.
  @@unique([clientId, templateId])
  @@index([companyId])
  @@map("anamneses")
}

// Registro do histórico da ficha (o inicial ou um acompanhamento). Imutável: sem
// alteração nem exclusão pela API; correções entram como novo acompanhamento.
model AnamnesisEntry {
  id                   String             @id @default(uuid())
  anamnesisId          String
  kind                 AnamnesisEntryKind
  // Data da consulta a que o registro se refere (não é a data em que foi gravado).
  consultationDate     DateTime           @db.Date
  appointmentId        String?
  // Criptografado (ver AnamnesisCryptoService); nulo no registro inicial.
  evolution            String?
  authorUserId         String
  authorProfessionalId String?
  createdAt            DateTime           @default(now())

  anamnesis          Anamnesis         @relation(fields: [anamnesisId], references: [id])
  appointment        Appointment?      @relation(fields: [appointmentId], references: [id])
  authorUser         User              @relation(fields: [authorUserId], references: [id])
  authorProfessional People?           @relation("AnamnesisEntryProfessional", fields: [authorProfessionalId], references: [id])
  answers            AnamnesisAnswer[]

  @@index([anamnesisId, consultationDate])
  @@map("anamnesis_entries")
}

// Resposta a uma pergunta em um registro. No acompanhamento só existem as das
// perguntas que mudaram.
model AnamnesisAnswer {
  id         String @id @default(uuid())
  entryId    String
  questionId String
  // JSON da resposta, criptografado (ver AnamnesisCryptoService).
  value      String

  entry    AnamnesisEntry    @relation(fields: [entryId], references: [id])
  question AnamnesisQuestion @relation(fields: [questionId], references: [id])

  @@unique([entryId, questionId])
  @@map("anamnesis_answers")
}

/**
 * Turma fixa: um horário de atendimento em turma, com vagas (ver docs/turmas.md).
 * Serviço, profissional e dias não mudam depois do cadastro; não há exclusão: a
 * turma é inativada por isActive.
 */
model ClassGroup {
  id             String    @id @default(uuid())
  companyId      String
  // Opcional e não único: serve só para identificar a turma.
  name           String?
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String?
  serviceId      String
  professionalId String
  // Quantidade máxima de alunos por sessão.
  capacity       Int
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  company               Company                @relation(fields: [companyId], references: [id])
  service               Service                @relation(fields: [serviceId], references: [id])
  professional          People                 @relation(fields: [professionalId], references: [id])
  days                  ClassGroupDay[]
  sessions              ClassSession[]
  recurringAppointments RecurringAppointment[]

  @@index([companyId, createdAt])
  @@index([professionalId])
  @@index([serviceId])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("class_groups")
}

// Dia e horário da turma fixa. O fim é o início mais a duração do serviço, como nos agendamentos.
model ClassGroupDay {
  id           String   @id @default(uuid())
  classGroupId String
  weekDay      WeekDay
  startTime    DateTime @db.Time(0)
  createdAt    DateTime @default(now())

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@index([classGroupId])
  @@map("class_group_days")
}

/**
 * Sessão da turma: uma ocorrência de atendimento em turma (ver docs/turmas.md).
 * Nasce de uma turma fixa, quando o primeiro aluno é encaixado naquele horário,
 * ou de um agendamento que vira turma (sessão avulsa, sem classGroupId). Cada
 * aluno tem o próprio agendamento, ligado a ela.
 */
model ClassSession {
  id               String    @id @default(uuid())
  companyId        String
  // Vazio na sessão avulsa (agendamento que virou turma).
  classGroupId     String?
  serviceId        String
  professionalId   String
  startAt          DateTime
  endAt            DateTime
  // Quantidade máxima de alunos (não contam os agendamentos cancelados).
  capacity         Int
  // Na sessão avulsa, repete o encaixe do agendamento que a originou; na turma fixa, sempre falso.
  overBooking      Boolean   @default(false)
  // Cancelamento da sessão inteira, com o motivo opcional (ex.: "Feriado").
  cancelledAt      DateTime?
  cancellationNote String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime?

  company      Company       @relation(fields: [companyId], references: [id])
  classGroup   ClassGroup?   @relation(fields: [classGroupId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  professional People        @relation(fields: [professionalId], references: [id])
  appointments Appointment[]

  // Na turma fixa, uma sessão por horário (as avulsas não entram).
  @@unique([classGroupId, startAt], where: raw("\"classGroupId\" IS NOT NULL"))
  @@index([companyId, startAt])
  @@index([professionalId, startAt])
  @@map("class_sessions")
}
