// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String
  password  String
  type      UserType
  companyId String
  // Profissional (People do tipo PROFESSIONAL) que este usuário representa; dá acesso à anamnese.
  peopleId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  company                   Company                    @relation(fields: [companyId], references: [id])
  people                    People?                    @relation(fields: [peopleId], references: [id])
  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]
  messageCampaigns          MessageCampaign[]
  agendaBlocks              AgendaBlock[]
  anamnesisTemplateVersions AnamnesisTemplateVersion[]
  anamnesisEntries          AnamnesisEntry[]
  // Adiantamentos de comissão que este usuário lançou.
  commissionAdvances        CommissionAdvance[]
  // Fechamentos de comissão que este usuário fez e os que desfez.
  closingsCreated           CommissionClosing[]        @relation("CommissionClosingCreatedBy")
  closingsCancelled         CommissionClosing[]        @relation("CommissionClosingCancelledBy")
  // Contas a pagar que este usuário lançou.
  payablesCreated           Payable[]                  @relation("PayableCreatedBy")

  // Parciais: um registro excluído logicamente não bloqueia o reuso do valor.
  @@unique([email], where: raw("\"deletedAt\" IS NULL"))
  // Um profissional pertence a no máximo um usuário ativo (usuários sem vínculo não conflitam).
  @@unique([peopleId], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@map("users")
}

// Sessão de refresh token (ver auth.md). Sem deletedAt: não é uma entidade de
// domínio, é revogada (revokedAt) em vez de excluída, como Notification.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  // SHA-256 do token bruto: permite localizar o registro por igualdade sem
  // guardar o valor original (o token nunca é persistido em texto puro).
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

// SUPER_ADMIN administra a plataforma (todas as empresas); ADMIN, apenas a própria empresa.
enum UserType {
  SUPER_ADMIN
  ADMIN
  USER
}

enum PeopleType {
  CLIENT
  EMPLOYEE
  PROFESSIONAL
  // Fornecedor: favorecido das contas a pagar (2026-11-10).
  SUPPLIER
}

enum ContactType {
  MAIN
  MESSAGE
  BRANCH
}

enum AddressType {
  MAIN
  MESSAGE
  BRANCH
}

// Mantida via seed: sem exclusão e sem deletedAt (ver docs/database.md)
model State {
  id        String    @id @default(uuid())
  name      String
  acronym   String    @unique @db.Char(2)
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  cities City[]

  @@map("states")
}

// Mantida via seed: sem exclusão e sem deletedAt (ver docs/database.md)
model City {
  id             String    @id @default(uuid())
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  stateId        String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  state          State           @relation(fields: [stateId], references: [id])
  addresses      Address[]
  clientAccounts ClientAccount[]

  @@unique([name, stateId])
  @@index([stateId])
  // GIN trigram: acelera a busca parcial (LIKE '%termo%') pelo nome normalizado.
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("cities")
}

// Empresas não são excluídas, apenas inativadas (ver docs/database.md): sem deletedAt.
model Company {
  id              String    @id @default(uuid())
  corporateReason String
  fantasyName     String?
  // CPF (11) ou CNPJ (14), sem máscara. VarChar: o Char completaria o CPF com espaços.
  document        String    @unique @db.VarChar(14)
  // Opcional: não se aplica a quem usa CPF.
  foundationDate  DateTime? @db.Date
  isActive        Boolean   @default(true)
  // Fuso IANA usado para interpretar janelas de atendimento e horários de recorrência.
  timezone        String    @default("America/Sao_Paulo")
  logoUrl         String?
  subdomain       String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime?

  users                 User[]
  people                People[]
  contacts              Contact[]
  addresses             Address[]
  services              Service[]
  paymentMethods        PaymentMethod[]
  businessHours         BusinessHour[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  anamnesisTemplates    AnamnesisTemplate[]
  anamneses             Anamnesis[]
  appointments          Appointment[]
  recurringAppointments RecurringAppointment[]
  plans                 Plan[]
  payments              Payment[]
  commissions           Commission[]
  commissionAdvances    CommissionAdvance[]
  commissionClosings    CommissionClosing[]
  expenseCategories     ExpenseCategory[]
  payables              Payable[]
  clientPlans           ClientPlan[]
  classGroups           ClassGroup[]
  classSessions         ClassSession[]
  featureAccess         CompanyFeatureAccess[]
  limit                 CompanyLimit?
  portalVerifications   PortalVerification[]
  portalSettings        PortalSettings?
  clientMessages        ClientMessage[]
  autoMessages          AutoMessage[]
  autoMessageLogs       AutoMessageLog[]
  messageCampaigns      MessageCampaign[]
  agendaBlocks          AgendaBlock[]
  portalAccessLinks     PortalAccessLink[]

  @@map("companies")
}

model People {
  id                 String     @id @default(uuid())
  name               String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName     String
  // Opcionais: o cliente poderá se cadastrar só com nome e telefone (contato).
  // CPF (11) ou, só no fornecedor, CNPJ (14), sem máscara.
  document           String?    @db.VarChar(14)
  birthDate          DateTime?  @db.Date
  profession         String?
  type               PeopleType
  companyId          String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime?
  deletedAt          DateTime?
  note               String?
  // Caminho público da foto (ex.: /uploads/people/<arquivo>.jpg), preenchido pelo upload.
  photoUrl           String?
  // Conta do app do cliente ligada a este cadastro (só pelo link da clínica ou
  // pelo cadastro feito no próprio app); no máximo um cadastro por conta em cada clínica.
  clientAccountId    String?
  // false: o cliente entrou sozinho pelo app e a clínica ainda não confirmou o
  // cadastro (telefone não conferido); até lá, no máximo 2 agendamentos futuros pelo app.
  portalConfirmed    Boolean    @default(true)
  // Só para profissional: recebe comissão (padrão sim; o vinculado a um usuário
  // ADMIN nasce sem). Religar vale dali em diante (commissionSince).
  receivesCommission Boolean    @default(true)
  commissionSince    DateTime?
  // Só no fornecedor: categoria de despesa principal (pré-preenche a conta a pagar).
  expenseCategoryId  String?

  company           Company               @relation(fields: [companyId], references: [id])
  expenseCategory   ExpenseCategory?      @relation(fields: [expenseCategoryId], references: [id])
  clientAccount     ClientAccount?        @relation(fields: [clientAccountId], references: [id])
  contacts          Contact[]
  addresses         Address[]
  portalAccessLinks PortalAccessLink[]
  // Serviços que o profissional atende (ver ServiceProfessional).
  services          ServiceProfessional[]

  // Uma pessoa participa dos agendamentos ora como cliente, ora como profissional.
  appointmentsAsClient        Appointment[]          @relation("AppointmentClient")
  appointmentsAsProfessional  Appointment[]          @relation("AppointmentProfessional")
  commissionsAsProfessional   Commission[]
  commissionAdvances          CommissionAdvance[]
  commissionClosings          CommissionClosing[]
  payablesAsPayee             Payable[]
  recurringAsClient           RecurringAppointment[] @relation("RecurringAppointmentClient")
  recurringAsProfessional     RecurringAppointment[] @relation("RecurringAppointmentProfessional")
  clientPlans                 ClientPlan[]
  users                       User[]
  anamnesesAsClient           Anamnesis[]            @relation("AnamnesisClient")
  anamnesisEntriesAsAuthor    AnamnesisEntry[]       @relation("AnamnesisEntryProfessional")
  classGroupsAsProfessional   ClassGroup[]
  classSessionsAsProfessional ClassSession[]

  // Parcial: um registro excluído logicamente não bloqueia o reuso do documento.
  // Pessoas sem documento não entram em conflito entre si.
  @@unique([companyId, document], where: raw("\"deletedAt\" IS NULL"))
  // Uma conta do app tem no máximo um cadastro ativo em cada clínica.
  @@unique([companyId, clientAccountId], where: raw("\"deletedAt\" IS NULL AND \"clientAccountId\" IS NOT NULL"))
  @@index([companyId])
  // GIN trigram: acelera a busca parcial (LIKE '%termo%') pelo nome normalizado.
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("people")
}

// Pertence a exatamente um dono (empresa ou pessoa) e tem telefone e/ou e-mail; ambos garantidos por CHECK na migration
model Contact {
  id          String      @id @default(uuid())
  type        ContactType
  phone       String?
  email       String?
  // Contato exibido para o dono; no máximo um por dono (índices parciais abaixo).
  isPrincipal Boolean     @default(false)
  companyId   String?
  peopleId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime?
  deletedAt   DateTime?

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  people  People?  @relation(fields: [peopleId], references: [id], onDelete: Restrict)

  @@unique([companyId], where: raw("\"isPrincipal\" AND \"deletedAt\" IS NULL"), map: "contacts_principal_company_key")
  @@unique([peopleId], where: raw("\"isPrincipal\" AND \"deletedAt\" IS NULL"), map: "contacts_principal_people_key")
  @@index([companyId])
  @@index([peopleId])
  @@map("contacts")
}

// Pertence a exatamente um dono (empresa ou pessoa), garantido por CHECK na migration
model Address {
  id           String      @id @default(uuid())
  type         AddressType
  cep          String      @db.Char(8)
  street       String
  neighborhood String?
  number       String
  complement   String?
  // Endereço exibido para o dono; no máximo um por dono (índices parciais abaixo).
  isPrincipal  Boolean     @default(false)
  cityId       String
  companyId    String?
  peopleId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime?
  deletedAt    DateTime?

  city    City     @relation(fields: [cityId], references: [id])
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  people  People?  @relation(fields: [peopleId], references: [id], onDelete: Restrict)

  @@unique([companyId], where: raw("\"isPrincipal\" AND \"deletedAt\" IS NULL"), map: "addresses_principal_company_key")
  @@unique([peopleId], where: raw("\"isPrincipal\" AND \"deletedAt\" IS NULL"), map: "addresses_principal_people_key")
  @@index([cityId])
  @@index([companyId])
  @@index([peopleId])
  @@map("addresses")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Por que a clínica cancelou a aula de turma (ver docs/turmas.md). Só esses
// cancelamentos deixam a sessão de plano ser reposta; o cancelado pelo cliente, não.
enum AppointmentCancelReason {
  CLASS_SESSION_CANCELLED
  CLASS_LEFT
}

// Modalidade de pagamento de uma contratação de plano.
enum PlanBillingType {
  INTEGRAL
  MONTHLY
}

// Forma da comissão do serviço (ver Service.commissionType).
enum CommissionType {
  PERCENT
  FIXED
}

// Situação gravada da conta a pagar ("atrasada" é derivada: pendente vencida).
enum PayableStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  PAID
  PENDING
  CANCELLED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Service {
  id              String          @id @default(uuid())
  name            String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName  String
  description     String?
  price           Decimal?        @db.Decimal(10, 2)
  color           String?
  // Duração em minutos, usada para calcular o fim do agendamento.
  duration        Int
  companyId       String
  isActive        Boolean         @default(true)
  // Aceita atendimento em turma (ver ClassGroup).
  allowsClasses   Boolean         @default(false)
  // Comissão do profissional por atendimento concluído: os dois vazios = sem
  // comissão. PERCENT: percentual do valor cobrado; FIXED: valor por atendimento.
  commissionType  CommissionType?
  commissionValue Decimal?        @db.Decimal(10, 2)
  // Quando a comissão passou a valer (definida sem haver antes): só os
  // atendimentos que terminam daí em diante geram comissão.
  commissionSince DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime?
  deletedAt       DateTime?

  company               Company                @relation(fields: [companyId], references: [id])
  appointments          Appointment[]
  recurringAppointments RecurringAppointment[]
  planItems             PlanItem[]
  classGroups           ClassGroup[]
  classSessions         ClassSession[]
  // Profissionais que atendem o serviço (o portal só mostra serviço com ao menos um).
  professionals         ServiceProfessional[]
  commissions           Commission[]

  @@unique([companyId, name], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("services")
}

// Sem deletedAt por decisão do domínio: o ciclo de vida é controlado pelo status.
model Appointment {
  id                     String                   @id @default(uuid())
  companyId              String
  clientId               String
  professionalId         String
  serviceId              String
  startAt                DateTime
  // Calculado a partir da duração do serviço (ver AppointmentService).
  endAt                  DateTime
  note                   String?
  status                 AppointmentStatus        @default(SCHEDULED)
  // Encaixe: agendamento avulso marcado fora do horário de funcionamento. Retrato
  // do momento em que foi marcado; não é recalculado se o horário mudar depois.
  overBooking            Boolean                  @default(false)
  // Onde o agendamento foi feito: na clínica ou pelo cliente, no portal.
  source                 AppointmentSource        @default(CLINIC)
  // Preenchido quando o agendamento foi gerado por uma recorrência.
  recurringAppointmentId String?
  // Preenchido quando o agendamento é de um aluno numa sessão de turma.
  classSessionId         String?
  // Preenchido quando a clínica cancelou a aula de turma (sessão cancelada ou saída da turma).
  cancelReason           AppointmentCancelReason?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime?

  company              Company               @relation(fields: [companyId], references: [id])
  client               People                @relation("AppointmentClient", fields: [clientId], references: [id])
  professional         People                @relation("AppointmentProfessional", fields: [professionalId], references: [id])
  service              Service               @relation(fields: [serviceId], references: [id])
  payment              Payment?
  commission           Commission?
  anamnesisEntries     AnamnesisEntry[]
  recurringAppointment RecurringAppointment? @relation(fields: [recurringAppointmentId], references: [id])
  classSession         ClassSession?         @relation(fields: [classSessionId], references: [id])

  @@index([companyId, startAt])
  @@index([professionalId, startAt])
  @@index([clientId, startAt])
  @@index([status, endAt])
  @@index([serviceId])
  @@index([recurringAppointmentId])
  @@index([classSessionId])
  @@map("appointments")
}

// Sem deletedAt por decisão do domínio: não há exclusão, apenas isActive.
model RecurringAppointment {
  id             String    @id @default(uuid())
  companyId      String
  clientId       String
  professionalId String
  serviceId      String
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  note           String?
  isActive       Boolean   @default(true)
  // Preenchido quando a recorrência é a agenda de um serviço de um plano contratado.
  clientPlanId   String?
  // Turma fixa em que a recorrência está encaixada (os dias são horários dela).
  classGroupId   String?
  // Saída da turma: quando o aluno saiu e o motivo (as aulas futuras da turma foram canceladas).
  classLeftAt    DateTime?
  classLeaveNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  company      Company        @relation(fields: [companyId], references: [id])
  clientPlan   ClientPlan?    @relation(fields: [clientPlanId], references: [id], onDelete: Restrict)
  client       People         @relation("RecurringAppointmentClient", fields: [clientId], references: [id])
  professional People         @relation("RecurringAppointmentProfessional", fields: [professionalId], references: [id])
  service      Service        @relation(fields: [serviceId], references: [id])
  classGroup   ClassGroup?    @relation(fields: [classGroupId], references: [id])
  days         RecurringDay[]
  appointments Appointment[]

  @@index([companyId, isActive])
  @@index([professionalId])
  @@index([clientId])
  @@index([serviceId])
  @@index([clientPlanId])
  @@index([classGroupId])
  @@map("recurring_appointments")
}

// Pacote de serviços vendido pela empresa. O valor mensal é definido pela empresa;
// os períodos de contratação (PlanPeriod) aplicam descontos sobre ele. Não há
// exclusão: o plano é desativado por isActive.
model Plan {
  id             String    @id @default(uuid())
  companyId      String
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  description    String?
  monthlyPrice   Decimal   @db.Decimal(10, 2)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  company     Company      @relation(fields: [companyId], references: [id])
  items       PlanItem[]
  periods     PlanPeriod[]
  clientPlans ClientPlan[]

  @@unique([companyId, name])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("plans")
}

// Serviço incluído em um plano. Faz parte do plano: é criado e substituído junto
// com ele, por isso usa exclusão física (ver docs/database.md).
model PlanItem {
  id              String   @id @default(uuid())
  planId          String
  serviceId       String
  // Atendimentos por semana deste serviço no plano (1 a 7, validado no DTO).
  sessionsPerWeek Int      @default(1)
  createdAt       DateTime @default(now())

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([planId, serviceId])
  @@index([serviceId])
  @@map("plan_items")
}

// Período de contratação de um plano, com os dois percentuais de desconto. Faz
// parte do plano (exclusão física); as contratações guardam cópia dos valores.
model PlanPeriod {
  id                     String    @id @default(uuid())
  planId                 String
  months                 Int
  // Desconto para pagamento integral do período.
  discountPercent        Decimal   @db.Decimal(5, 2)
  // Desconto de cada parcela no pagamento mensal.
  monthlyDiscountPercent Decimal   @db.Decimal(5, 2)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, months])
  @@map("plan_periods")
}

// Contratação de um plano por um cliente. Os valores são congelados na
// contratação: mudar o plano ou os serviços depois não os altera. Cada serviço do
// plano vira uma recorrência própria (RecurringAppointment.clientPlanId).
model ClientPlan {
  id              String          @id @default(uuid())
  companyId       String
  clientId        String
  planId          String
  billingType     PlanBillingType
  months          Int
  // Período pelo calendário (datas puras, sem fuso).
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  // Valor mensal do plano no momento da contratação.
  monthlyAmount   Decimal         @db.Decimal(10, 2)
  // Percentual aplicado conforme a modalidade (integral ou mensal).
  discountPercent Decimal         @db.Decimal(5, 2)
  totalAmount     Decimal         @db.Decimal(10, 2)
  // Vencimento do primeiro pagamento; os seguintes vencem mês a mês.
  firstDueDate    DateTime?       @db.Date
  // Vazio enquanto a contratação está ativa; preenchido no cancelamento.
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime?

  company               Company                @relation(fields: [companyId], references: [id])
  client                People                 @relation(fields: [clientId], references: [id])
  plan                  Plan                   @relation(fields: [planId], references: [id])
  payments              Payment[]
  recurringAppointments RecurringAppointment[]

  @@index([companyId])
  @@index([clientId])
  @@index([planId])
  @@map("client_plans")
}

// Faz parte do agendamento recorrente: é criada e substituída junto com ele,
// por isso usa exclusão física (ver docs/database.md).
model RecurringDay {
  id                     String    @id @default(uuid())
  recurringAppointmentId String
  weekDay                WeekDay
  startTime              DateTime  @db.Time(0)
  endTime                DateTime  @db.Time(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime?

  recurringAppointment RecurringAppointment @relation(fields: [recurringAppointmentId], references: [id], onDelete: Cascade)

  @@index([recurringAppointmentId])
  @@map("recurring_days")
}

model PaymentMethod {
  id             String    @id @default(uuid())
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  companyId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?

  company            Company             @relation(fields: [companyId], references: [id])
  payments           Payment[]
  commissionClosings CommissionClosing[]
  commissionAdvances CommissionAdvance[]
  payables           Payable[]

  // Único pelo nome normalizado: "PIX", "Pix" e "pix" são o mesmo método.
  @@unique([companyId, normalizedName], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("payment_methods")
}

model Payment {
  id              String        @id @default(uuid())
  // A empresa fica no próprio pagamento: os de plano não têm agendamento.
  companyId       String
  // Um pagamento é de um agendamento ou de uma contratação de plano, nunca dos dois.
  appointmentId   String?
  clientPlanId    String?
  amount          Decimal       @db.Decimal(10, 2)
  // Vencimento pelo calendário, opcional. Em agendamentos de recorrência, acompanha a data do agendamento.
  dueDate         DateTime?     @db.Date
  // Preenchido apenas quando o pagamento está PAID.
  paidAt          DateTime?
  // Opcional enquanto PENDING: o método é informado na baixa para PAID.
  paymentMethodId String?
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime?
  deletedAt       DateTime?

  company       Company        @relation(fields: [companyId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  clientPlan    ClientPlan?    @relation(fields: [clientPlanId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  // Parcial: um pagamento excluído libera o agendamento para um novo pagamento.
  @@unique([appointmentId], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@index([clientPlanId])
  @@index([paymentMethodId])
  @@map("payments")
}

// Janela de atendimento de uma empresa em um dia da semana. Uma empresa pode ter
// mais de uma janela no mesmo dia (ex.: manhã e tarde). Empresa sem nenhuma
// janela cadastrada não restringe horários (ver docs/business-rules.md).
model BusinessHour {
  id        String    @id @default(uuid())
  companyId String
  weekDay   WeekDay
  openAt    DateTime  @db.Time(0)
  closeAt   DateTime  @db.Time(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, weekDay])
  @@map("business_hours")
}

/**
 * Aviso para a empresa agir. Ainda não há tipos em uso: a entidade é mantida para
 * implementações futuras. Notificações não são excluídas: são resolvidas (ver docs/database.md).
 */
model Notification {
  id         String    @id @default(uuid())
  companyId  String
  message    String
  readAt     DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, resolvedAt])
  @@map("notifications")
}

// Ações sensíveis registradas na auditoria. Cresce junto com as funcionalidades
// que gravam o registro (a anamnese acrescentará as suas).
enum AuditAction {
  USER_LINK_CHANGED
  USER_TYPE_CHANGED
  USER_RESTORED
  ANAMNESIS_TEMPLATE_CREATED
  ANAMNESIS_TEMPLATE_UPDATED
  ANAMNESIS_VIEWED
  ANAMNESIS_LISTED
  ANAMNESIS_ENTRY_CREATED
  ANAMNESIS_PDF_GENERATED
  COMPANY_ACCESS_CHANGED
  PORTAL_ACCESS_LINK_CREATED
  PORTAL_CLIENT_CONFIRMED
  AGENDA_BLOCK_CREATED
  AGENDA_BLOCK_REMOVED
}

/**
 * Registro de uma ação sensível: quem fez o quê, em qual alvo e quando. Só
 * recebe inserções (sem deletedAt nem updatedAt): não é alterado nem excluído
 * pela API (ver docs/database.md).
 */
model AuditLog {
  id         String      @id @default(uuid())
  companyId  String
  userId     String
  action     AuditAction
  // Tipo e código do alvo da ação (ex.: USER e o id do usuário alterado).
  entityType String
  entityId   String
  // Cliente a que a ação se refere, quando houver (sem relação: o registro vale mesmo se o cliente for removido).
  clientId   String?
  ip         String?
  createdAt  DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, clientId])
  @@map("audit_logs")
}

enum AnamnesisQuestionType {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  NUMBER
  DATE
  SCALE
}

// Modelo de ficha de anamnese da empresa. Não é excluído: é inativado (isActive).
model AnamnesisTemplate {
  id             String    @id @default(uuid())
  companyId      String
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação (ver normalizeForSearch):
  // sustenta a busca e a unicidade do nome sem diferenciar maiúsculas nem acentos.
  normalizedName String
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  company   Company                    @relation(fields: [companyId], references: [id])
  versions  AnamnesisTemplateVersion[]
  anamneses Anamnesis[]

  @@unique([companyId, normalizedName])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("anamnesis_templates")
}

// Conjunto de perguntas do modelo em um momento. Imutável: editar as perguntas
// cria a versão seguinte, sem exclusão física (as fichas ficam presas à versão).
model AnamnesisTemplateVersion {
  id          String   @id @default(uuid())
  templateId  String
  version     Int
  createdById String
  createdAt   DateTime @default(now())

  template  AnamnesisTemplate   @relation(fields: [templateId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  questions AnamnesisQuestion[]
  anamneses Anamnesis[]

  // Também barra duas edições simultâneas que gerariam o mesmo número de versão.
  @@unique([templateId, version])
  @@map("anamnesis_template_versions")
}

model AnamnesisQuestion {
  id          String                @id @default(uuid())
  versionId   String
  // Posição na lista (de 1 em diante), definida pela ordem em que o front envia as perguntas.
  position    Int
  label       String
  helpText    String?
  type        AnamnesisQuestionType
  isRequired  Boolean               @default(false)
  // Só para escolha única e múltipla; vazio nos demais tipos.
  options     String[]
  // Só para sim ou não (ex.: "Qual?").
  detailLabel String?

  version AnamnesisTemplateVersion @relation(fields: [versionId], references: [id])
  answers AnamnesisAnswer[]

  @@unique([versionId, position])
  @@map("anamnesis_questions")
}

enum AnamnesisEntryKind {
  INITIAL
  FOLLOW_UP
}

// Ficha de um cliente em um modelo: o dossiê ao qual os registros se ligam. Presa
// à versão do modelo vigente quando foi criada. Não é excluída pela API.
model Anamnesis {
  id         String   @id @default(uuid())
  companyId  String
  clientId   String
  templateId String
  versionId  String
  createdAt  DateTime @default(now())

  company  Company                  @relation(fields: [companyId], references: [id])
  client   People                   @relation("AnamnesisClient", fields: [clientId], references: [id])
  template AnamnesisTemplate        @relation(fields: [templateId], references: [id])
  version  AnamnesisTemplateVersion @relation(fields: [versionId], references: [id])
  entries  AnamnesisEntry[]

  // Uma ficha por cliente e por modelo.
  @@unique([clientId, templateId])
  @@index([companyId])
  @@map("anamneses")
}

// Registro do histórico da ficha (o inicial ou um acompanhamento). Imutável: sem
// alteração nem exclusão pela API; correções entram como novo acompanhamento.
model AnamnesisEntry {
  id                   String             @id @default(uuid())
  anamnesisId          String
  kind                 AnamnesisEntryKind
  // Data da consulta a que o registro se refere (não é a data em que foi gravado).
  consultationDate     DateTime           @db.Date
  appointmentId        String?
  // Criptografado (ver AnamnesisCryptoService); nulo no registro inicial.
  evolution            String?
  authorUserId         String
  authorProfessionalId String?
  createdAt            DateTime           @default(now())

  anamnesis          Anamnesis         @relation(fields: [anamnesisId], references: [id])
  appointment        Appointment?      @relation(fields: [appointmentId], references: [id])
  authorUser         User              @relation(fields: [authorUserId], references: [id])
  authorProfessional People?           @relation("AnamnesisEntryProfessional", fields: [authorProfessionalId], references: [id])
  answers            AnamnesisAnswer[]

  @@index([anamnesisId, consultationDate])
  @@map("anamnesis_entries")
}

// Resposta a uma pergunta em um registro. No acompanhamento só existem as das
// perguntas que mudaram.
model AnamnesisAnswer {
  id         String @id @default(uuid())
  entryId    String
  questionId String
  // JSON da resposta, criptografado (ver AnamnesisCryptoService).
  value      String

  entry    AnamnesisEntry    @relation(fields: [entryId], references: [id])
  question AnamnesisQuestion @relation(fields: [questionId], references: [id])

  @@unique([entryId, questionId])
  @@map("anamnesis_answers")
}

/**
 * Turma fixa: um horário de atendimento em turma, com vagas (ver docs/turmas.md).
 * Serviço, profissional e dias não mudam depois do cadastro; não há exclusão: a
 * turma é inativada por isActive.
 */
model ClassGroup {
  id             String    @id @default(uuid())
  companyId      String
  // Opcional e não único: serve só para identificar a turma.
  name           String?
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String?
  serviceId      String
  professionalId String
  // Quantidade máxima de alunos por sessão.
  capacity       Int
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  company               Company                @relation(fields: [companyId], references: [id])
  service               Service                @relation(fields: [serviceId], references: [id])
  professional          People                 @relation(fields: [professionalId], references: [id])
  days                  ClassGroupDay[]
  sessions              ClassSession[]
  recurringAppointments RecurringAppointment[]

  @@index([companyId, createdAt])
  @@index([professionalId])
  @@index([serviceId])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("class_groups")
}

// Dia e horário da turma fixa. O fim é o início mais a duração do serviço, como nos agendamentos.
model ClassGroupDay {
  id           String   @id @default(uuid())
  classGroupId String
  weekDay      WeekDay
  startTime    DateTime @db.Time(0)
  createdAt    DateTime @default(now())

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@index([classGroupId])
  @@map("class_group_days")
}

/**
 * Sessão da turma: uma ocorrência de atendimento em turma (ver docs/turmas.md).
 * Nasce de uma turma fixa, quando o primeiro aluno é encaixado naquele horário,
 * ou de um agendamento que vira turma (sessão avulsa, sem classGroupId). Cada
 * aluno tem o próprio agendamento, ligado a ela.
 */
model ClassSession {
  id               String    @id @default(uuid())
  companyId        String
  // Vazio na sessão avulsa (agendamento que virou turma).
  classGroupId     String?
  serviceId        String
  professionalId   String
  startAt          DateTime
  endAt            DateTime
  // Quantidade máxima de alunos (não contam os agendamentos cancelados).
  capacity         Int
  // Na sessão avulsa, repete o encaixe do agendamento que a originou; na turma fixa, sempre falso.
  overBooking      Boolean   @default(false)
  // Cancelamento da sessão inteira, com o motivo opcional (ex.: "Feriado").
  cancelledAt      DateTime?
  cancellationNote String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime?

  company      Company       @relation(fields: [companyId], references: [id])
  classGroup   ClassGroup?   @relation(fields: [classGroupId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  professional People        @relation(fields: [professionalId], references: [id])
  appointments Appointment[]

  // Na turma fixa, uma sessão por horário (as avulsas não entram).
  @@unique([classGroupId, startAt], where: raw("\"classGroupId\" IS NOT NULL"))
  @@index([companyId, startAt])
  @@index([professionalId, startAt])
  @@map("class_sessions")
}

/**
 * O que os administradores de uma empresa podem fazer em cada funcionalidade
 * (ver docs/business-rules.md, "Acessos e limites"). Sem linha = sem acesso:
 * uma funcionalidade nova nasce desmarcada em todas as empresas.
 */
model CompanyFeatureAccess {
  id        String  @id @default(uuid())
  companyId String
  // Chave do catálogo de funcionalidades (código, em access-catalog.ts).
  feature   String
  canView   Boolean @default(false)
  canEdit   Boolean @default(false)
  canCreate Boolean @default(false)
  canRemove Boolean @default(false)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, feature])
  @@map("company_feature_access")
}

// Limites do plano da empresa. Baixar abaixo do uso é permitido: só bloqueia novos cadastros.
model CompanyLimit {
  companyId        String @id
  // Profissionais ativos, contando o administrador que atua.
  maxProfessionals Int
  // Administradores (usuários com acesso).
  maxAdmins        Int

  company Company @relation(fields: [companyId], references: [id])

  @@map("company_limits")
}

/**
 * Código enviado por WhatsApp para o cliente entrar no portal da clínica (ver
 * docs/business-rules.md, "Portal do cliente"). Só o hash do código é gravado.
 */
model PortalVerification {
  id         String    @id @default(uuid())
  companyId  String
  // Telefone com DDD, só dígitos (10 ou 11), como nos contatos.
  phone      String
  codeHash   String
  // Tentativas erradas; no limite, o código deixa de valer.
  attempts   Int       @default(0)
  expiresAt  DateTime
  // Código conferido: abre a escolha da pessoa e a criação da sessão.
  verifiedAt DateTime?
  // Já virou sessão: não pode ser usado de novo.
  usedAt     DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, phone, createdAt])
  @@map("portal_verifications")
}

// Sessão do cliente no portal (um aparelho). Token opaco: só o hash é gravado.
model PortalSession {
  id              String    @id @default(uuid())
  // A sessão é da conta do cliente, não de uma clínica: vale em todos os locais dela.
  clientAccountId String
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  userAgent       String?
  createdAt       DateTime  @default(now())

  clientAccount     ClientAccount      @relation(fields: [clientAccountId], references: [id])
  pushSubscriptions PushSubscription[]

  @@index([clientAccountId])
  @@map("portal_sessions")
}

// Aparelho com os avisos do app ativados (Web Push). Fica ligado à sessão: ao
// sair do app a inscrição é apagada, e quem entrar depois no mesmo aparelho não
// recebe os avisos da conta anterior. Sessão vencida ou revogada não recebe.
model PushSubscription {
  id              String   @id @default(uuid())
  clientAccountId String
  portalSessionId String
  // Endereço de entrega do serviço de push do navegador: um por aparelho.
  endpoint        String   @unique
  // Chaves do aparelho que cifram o conteúdo do aviso (padrão Web Push).
  p256dh          String
  auth            String
  userAgent       String?
  createdAt       DateTime @default(now())

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id])
  portalSession PortalSession @relation(fields: [portalSessionId], references: [id], onDelete: Cascade)

  @@index([clientAccountId])
  @@map("push_subscriptions")
}

// Tipo do aviso; define qual interruptor do cliente vale (ver ClientNotifierService).
enum ClientMessageKind {
  REMINDER
  APPOINTMENT
  BIRTHDAY
  MISS_YOU
  CAMPAIGN
  TEST
}

// Aviso recebido pelo cliente: a caixa de Avisos do app. Gravado mesmo sem
// aparelho inscrito, para o cliente ver depois.
model ClientMessage {
  id              String            @id @default(uuid())
  clientAccountId String
  // Clínica que enviou; nulo no aviso de teste (é do Orari).
  companyId       String?
  kind            ClientMessageKind
  title           String            @db.VarChar(100)
  body            String            @db.VarChar(500)
  // Caminho do app aberto ao tocar no aviso (ex.: /app/agendamentos).
  url             String?
  readAt          DateTime?
  createdAt       DateTime          @default(now())

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id])
  company       Company?      @relation(fields: [companyId], references: [id])

  @@index([clientAccountId, createdAt])
  @@map("client_messages")
}

// Conta do cliente no app (portal), única no Orari e com senha. Cada clínica
// continua com o próprio cadastro do cliente (People), ligado a esta conta.
model ClientAccount {
  id                  String    @id @default(uuid())
  // Telefone com DDD, só dígitos (10 ou 11), como nos contatos. É o login.
  phone               String    @unique @db.VarChar(11)
  name                String
  passwordHash        String
  // "Meus dados" do app: o cadastro do cliente, copiado para o cadastro em
  // cada clínica ligada à conta ao salvar (ver PortalProfileService).
  email               String?
  // CPF sem máscara (11 dígitos).
  document            String?   @db.Char(11)
  birthDate           DateTime? @db.Date
  profession          String?
  // Foto da conta; cada clínica recebe a própria cópia do arquivo.
  photoUrl            String?
  // Endereço principal (o mesmo formato dos endereços das pessoas).
  addressCep          String?   @db.Char(8)
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCityId       String?
  // Interruptores dos avisos do app (Menu): lembretes e agendamentos; novidades
  // e promoções. Desligado, o aviso daquele tipo nem é gravado nem enviado.
  notifyAppointments  Boolean   @default(true)
  notifyPromotions    Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime?

  addressCity City? @relation(fields: [addressCityId], references: [id])

  people            People[]
  sessions          PortalSession[]
  pushSubscriptions PushSubscription[]
  messages          ClientMessage[]

  @@map("client_accounts")
}

enum AppointmentSource {
  CLINIC
  PORTAL
}

// Regras do portal do cliente definidas pela clínica (ver docs/business-rules.md, "Portal do cliente").
// Ramo do estabelecimento na busca do app.
enum BusinessSegment {
  BARBERSHOP
  BEAUTY_SALON
  AESTHETICS
  NAIL_SALON
  EYEBROW_DESIGN
  PHYSIOTHERAPY
  PILATES
  PSYCHOLOGY
  NUTRITION
  DENTISTRY
  OTHER
}

model PortalSettings {
  companyId         String           @id
  // Desligado até a clínica ligar.
  enabled           Boolean          @default(false)
  // Antecedência mínima para o cliente agendar.
  minAdvanceMinutes Int              @default(60)
  // Até quantos dias à frente o cliente pode agendar.
  maxDaysAhead      Int              @default(30)
  // Até quantas horas antes o cliente pode cancelar.
  cancelUntilHours  Int              @default(24)
  // A clínica aparece na busca de estabelecimentos do app (desligado até ela escolher).
  listed            Boolean          @default(false)
  // Ramo do estabelecimento, mostrado na busca; obrigatório para aparecer nela.
  segment           BusinessSegment?
  updatedAt         DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@map("portal_settings")
}

// Quais profissionais atendem cada serviço. No portal, o serviço só aparece com ao menos um.
model ServiceProfessional {
  serviceId String
  peopleId  String
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id])
  people  People  @relation(fields: [peopleId], references: [id])

  @@id([serviceId, peopleId])
  @@index([peopleId])
  @@map("service_professionals")
}

/**
 * Link de acesso ao portal gerado pela clínica para um cliente (enviado por ela,
 * à mão, ou mostrado em QR code). Uso único e curto: só o hash do token é gravado.
 */
model PortalAccessLink {
  id        String    @id @default(uuid())
  companyId String
  peopleId  String
  tokenHash String    @unique
  expiresAt DateTime
  // Já virou sessão (ou foi substituído por um link mais novo).
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])
  people  People  @relation(fields: [peopleId], references: [id])

  @@index([peopleId])
  @@map("portal_access_links")
}

// Situação que dispara uma mensagem automática ao cliente do app (ver
// docs/business-rules.md, "Mensagens automáticas").
enum AutoMessageKind {
  REMINDER
  APPOINTMENT_CREATED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  BIRTHDAY
  MISS_YOU
}

// Configuração de uma situação numa clínica. Sem linha, valem os padrões
// (auto-message.catalog.ts); a linha nasce no primeiro "Salvar".
model AutoMessage {
  id              String          @id @default(uuid())
  companyId       String
  kind            AutoMessageKind
  enabled         Boolean
  // Texto com variáveis ({nome}, {data}…), trocadas no envio.
  body            String          @db.VarChar(500)
  // Lembrete: minutos antes do horário (ex.: [1440, 30] = 24h e 30 min).
  reminderOffsets Int[]
  // Sentimos sua falta: dias sem vir depois do último atendimento.
  missYouDays     Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, kind])
  @@map("auto_messages")
}

// Uma mensagem automática já enviada. A chave única (ex.: lembrete 1440 do
// agendamento X) impede o envio repetido quando o job roda de novo.
model AutoMessageLog {
  id              String          @id @default(uuid())
  companyId       String
  kind            AutoMessageKind
  dedupKey        String          @unique
  clientAccountId String
  createdAt       DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@map("auto_message_logs")
}

// Mensagem escrita pela clínica e enviada a todos os clientes com o app
// (Mensagens → Enviar). Uma por dia por clínica (ver docs/business-rules.md).
model MessageCampaign {
  id          String   @id @default(uuid())
  companyId   String
  // Quem enviou (usuário ADMIN da clínica).
  createdById String
  title       String   @db.VarChar(100)
  // Texto com {nome} e {estabelecimento}, trocados para cada cliente.
  body        String   @db.VarChar(500)
  // Clientes que receberam na caixa de Avisos (quem desligou as promoções não conta).
  recipients  Int      @default(0)
  createdAt   DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([companyId, createdAt])
  @@map("message_campaigns")
}

// Horário bloqueado na agenda da empresa (ex.: um treinamento, uma reforma).
// Conta como fora do funcionamento: só o encaixe entra nele (ver
// BusinessHourService.isWithinBusinessHours). Desbloquear apaga o registro; a
// auditoria guarda quem bloqueou e quem desbloqueou.
model AgendaBlock {
  id          String   @id @default(uuid())
  companyId   String
  // Início e fim em UTC, no mesmo dia do relógio da empresa.
  startAt     DateTime
  endAt       DateTime
  // Quem bloqueou.
  createdById String
  createdAt   DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([companyId, startAt])
  @@map("agenda_blocks")
}

// Comissão do profissional por atendimento concluído (uma por atendimento),
// gerada pelo CommissionJob. Base, regra e valor ficam congelados: mudar a
// comissão do serviço depois não mexe no que já foi gerado.
model Commission {
  id             String         @id @default(uuid())
  companyId      String
  appointmentId  String         @unique
  professionalId String
  serviceId      String
  // Valor sobre o qual a comissão foi calculada (pagamento, preço ou sessão de pacote).
  baseAmount     Decimal        @db.Decimal(10, 2)
  type           CommissionType
  // Percentual ou valor fixo da regra no momento da geração.
  rate           Decimal        @db.Decimal(10, 2)
  amount         Decimal        @db.Decimal(10, 2)
  // Fechamento que a quitou; vazio = em aberto.
  closingId      String?
  createdAt      DateTime       @default(now())

  company      Company            @relation(fields: [companyId], references: [id])
  closing      CommissionClosing? @relation(fields: [closingId], references: [id])
  appointment  Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  professional People             @relation(fields: [professionalId], references: [id])
  service      Service            @relation(fields: [serviceId], references: [id])

  @@index([companyId, professionalId])
  @@index([serviceId])
  @@map("commissions")
}

// Adiantamento de comissão a um profissional: abatido no fechamento. Enquanto
// não é fechado, pode ser excluído (exclusão física: lançamento errado).
model CommissionAdvance {
  id              String   @id @default(uuid())
  companyId       String
  professionalId  String
  amount          Decimal  @db.Decimal(10, 2)
  // Data do adiantamento pelo calendário (pode ser passada, nunca futura).
  date            DateTime @db.Date
  note            String?
  // Como foi pago (vazio nos lançados antes de 2026-11-10).
  paymentMethodId String?
  // Usuário que lançou ("Lançado por").
  createdById     String
  // Fechamento que o abateu; vazio = em aberto (pode ser excluído).
  closingId       String?
  createdAt       DateTime @default(now())

  company       Company            @relation(fields: [companyId], references: [id])
  closing       CommissionClosing? @relation(fields: [closingId], references: [id])
  professional  People             @relation(fields: [professionalId], references: [id])
  paymentMethod PaymentMethod?     @relation(fields: [paymentMethodId], references: [id])
  // Conta paga gerada no Contas a pagar.
  payable       Payable?
  createdBy     User               @relation(fields: [createdById], references: [id])

  @@index([companyId, professionalId])
  @@map("commission_advances")
}

// Fechamento da comissão de um profissional: quita as comissões e os
// adiantamentos em aberto até a data de corte e gera o recibo (número
// sequencial por empresa). Desfazer (só o último do profissional) marca como
// cancelado e devolve tudo ao "em aberto"; o número não é reaproveitado.
model CommissionClosing {
  id                String    @id @default(uuid())
  companyId         String
  number            Int
  professionalId    String
  // Data de corte (calendário da empresa): atendimentos e adiantamentos até ela.
  cutoffDate        DateTime  @db.Date
  // Pagamento ao profissional: data (calendário) e método.
  paidAt            DateTime  @db.Date
  paymentMethodId   String
  commissionTotal   Decimal   @db.Decimal(10, 2)
  advanceTotal      Decimal   @db.Decimal(10, 2)
  paidAmount        Decimal   @db.Decimal(10, 2)
  appointmentsCount Int
  // Cópia do detalhamento no fechamento (atendimentos e adiantamentos): o
  // recibo, inclusive o cancelado, sai sempre igual ao que foi assinado.
  details           Json
  createdById       String
  createdAt         DateTime  @default(now())
  cancelledAt       DateTime?
  cancelledById     String?

  company       Company             @relation(fields: [companyId], references: [id])
  professional  People              @relation(fields: [professionalId], references: [id])
  paymentMethod PaymentMethod       @relation(fields: [paymentMethodId], references: [id])
  createdBy     User                @relation("CommissionClosingCreatedBy", fields: [createdById], references: [id])
  cancelledBy   User?               @relation("CommissionClosingCancelledBy", fields: [cancelledById], references: [id])
  commissions   Commission[]
  advances      CommissionAdvance[]
  // Conta paga gerada no Contas a pagar (não há quando nada foi pago).
  payable       Payable?

  @@unique([companyId, number])
  @@index([companyId, professionalId])
  @@map("commission_closings")
}

// Categoria de despesa das contas a pagar (ex.: Aluguel, Energia), cadastrável
// pela empresa. Não há exclusão física: é inativada (deletedAt).
model ExpenseCategory {
  id             String    @id @default(uuid())
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  companyId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?

  company   Company   @relation(fields: [companyId], references: [id])
  // Fornecedores que têm esta como categoria principal.
  suppliers People[]
  payables  Payable[]

  // Único pelo nome normalizado entre os ativos: "Aluguel" e "aluguel" são a mesma.
  @@unique([companyId, normalizedName], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@map("expense_categories")
}

// Conta a pagar da empresa (só o ADMIN). Repetida ou parcelada, cada mês é uma
// conta com o mesmo seriesId e o número da parcela. "Atrasada" não é gravada:
// é a pendente com vencimento antes de hoje (no fuso da empresa).
model Payable {
  id                  String        @id @default(uuid())
  companyId           String
  description         String
  // Fornecedor ou profissional; vazio quando não há (ex.: imposto).
  payeeId             String?
  categoryId          String
  amount              Decimal       @db.Decimal(10, 2)
  dueDate             DateTime      @db.Date
  note                String?
  status              PayableStatus @default(PENDING)
  // Preenchidos quando paga: data (calendário) e método.
  paidAt              DateTime?     @db.Date
  paymentMethodId     String?
  // Repetição: as contas geradas juntas; "parcela installment de installments".
  seriesId            String?
  installment         Int?
  installments        Int?
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime?
  cancelledAt         DateTime?
  // Gerada pela comissão (protegida: muda só pela tela Comissões).
  commissionClosingId String?       @unique
  commissionAdvanceId String?       @unique

  company           Company            @relation(fields: [companyId], references: [id])
  commissionClosing CommissionClosing? @relation(fields: [commissionClosingId], references: [id])
  commissionAdvance CommissionAdvance? @relation(fields: [commissionAdvanceId], references: [id])
  payee             People?            @relation(fields: [payeeId], references: [id])
  category          ExpenseCategory    @relation(fields: [categoryId], references: [id])
  paymentMethod     PaymentMethod?     @relation(fields: [paymentMethodId], references: [id])
  createdBy         User               @relation("PayableCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, status, dueDate])
  @@index([seriesId])
  @@map("payables")
}
