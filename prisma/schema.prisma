// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String
  password  String
  type      UserType
  companyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  company       Company        @relation(fields: [companyId], references: [id])
  refreshTokens RefreshToken[]

  // Parciais: um registro excluído logicamente não bloqueia o reuso do valor.
  @@unique([email], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@map("users")
}

// Sessão de refresh token (ver auth.md). Sem deletedAt: não é uma entidade de
// domínio, é revogada (revokedAt) em vez de excluída, como Notification.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  // SHA-256 do token bruto: permite localizar o registro por igualdade sem
  // guardar o valor original (o token nunca é persistido em texto puro).
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

// SUPER_ADMIN administra a plataforma (todas as empresas); ADMIN, apenas a própria empresa.
enum UserType {
  SUPER_ADMIN
  ADMIN
  USER
}

enum PeopleType {
  CLIENT
  EMPLOYEE
  PROFESSIONAL
}

enum ContactType {
  MAIN
  MESSAGE
  BRANCH
}

enum AddressType {
  MAIN
  MESSAGE
  BRANCH
}

// Mantida via seed: sem exclusão e sem deletedAt (ver docs/database.md)
model State {
  id        String    @id @default(uuid())
  name      String
  acronym   String    @unique @db.Char(2)
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  cities City[]

  @@map("states")
}

// Mantida via seed: sem exclusão e sem deletedAt (ver docs/database.md)
model City {
  id             String    @id @default(uuid())
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  stateId        String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  state     State     @relation(fields: [stateId], references: [id])
  addresses Address[]

  @@unique([name, stateId])
  @@index([stateId])
  // GIN trigram: acelera a busca parcial (LIKE '%termo%') pelo nome normalizado.
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("cities")
}

// Empresas não são excluídas, apenas inativadas (ver docs/database.md): sem deletedAt.
model Company {
  id              String    @id @default(uuid())
  corporateReason String
  fantasyName     String?
  cnpj            String    @unique @db.Char(14)
  foundationDate  DateTime  @db.Date
  isActive        Boolean   @default(true)
  // Fuso IANA usado para interpretar janelas de atendimento e horários de recorrência.
  timezone        String    @default("America/Sao_Paulo")
  logoUrl         String?
  subdomain       String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime?

  users                 User[]
  people                People[]
  contacts              Contact[]
  addresses             Address[]
  services              Service[]
  paymentMethods        PaymentMethod[]
  businessHours         BusinessHour[]
  notifications         Notification[]
  appointments          Appointment[]
  recurringAppointments RecurringAppointment[]
  plans                 Plan[]
  payments              Payment[]

  @@map("companies")
}

model People {
  id             String     @id @default(uuid())
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  document       String     @db.Char(11)
  birthDate      DateTime   @db.Date
  profession     String?
  type           PeopleType
  companyId      String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?
  note           String?

  company   Company   @relation(fields: [companyId], references: [id])
  contacts  Contact[]
  addresses Address[]

  // Uma pessoa participa dos agendamentos ora como cliente, ora como profissional.
  appointmentsAsClient       Appointment[]          @relation("AppointmentClient")
  appointmentsAsProfessional Appointment[]          @relation("AppointmentProfessional")
  recurringAsClient          RecurringAppointment[] @relation("RecurringAppointmentClient")
  recurringAsProfessional    RecurringAppointment[] @relation("RecurringAppointmentProfessional")

  // Parcial: um registro excluído logicamente não bloqueia o reuso do documento.
  @@unique([companyId, document], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  // GIN trigram: acelera a busca parcial (LIKE '%termo%') pelo nome normalizado.
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("people")
}

// Pertence a exatamente um dono (empresa ou pessoa) e tem telefone e/ou e-mail; ambos garantidos por CHECK na migration
model Contact {
  id        String      @id @default(uuid())
  type      ContactType
  phone     String?
  email     String?
  companyId String?
  peopleId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  people  People?  @relation(fields: [peopleId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([peopleId])
  @@map("contacts")
}

// Pertence a exatamente um dono (empresa ou pessoa), garantido por CHECK na migration
model Address {
  id           String      @id @default(uuid())
  type         AddressType
  cep          String      @db.Char(8)
  street       String
  neighborhood String?
  number       String
  complement   String?
  cityId       String
  companyId    String?
  peopleId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime?
  deletedAt    DateTime?

  city    City     @relation(fields: [cityId], references: [id])
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  people  People?  @relation(fields: [peopleId], references: [id], onDelete: Restrict)

  @@index([cityId])
  @@index([companyId])
  @@index([peopleId])
  @@map("addresses")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PAID
  PENDING
  CANCELLED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Service {
  id             String    @id @default(uuid())
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  description    String?
  price          Decimal?  @db.Decimal(10, 2)
  color          String?
  // Duração em minutos, usada para calcular o fim do agendamento.
  duration       Int
  companyId      String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?

  company               Company                @relation(fields: [companyId], references: [id])
  appointments          Appointment[]
  recurringAppointments RecurringAppointment[]
  planItems             PlanItem[]

  @@unique([companyId, name], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("services")
}

// Sem deletedAt por decisão do domínio: o ciclo de vida é controlado pelo status.
model Appointment {
  id                     String            @id @default(uuid())
  companyId              String
  clientId               String
  professionalId         String
  serviceId              String
  startAt                DateTime
  // Calculado a partir da duração do serviço (ver AppointmentService).
  endAt                  DateTime
  note                   String?
  status                 AppointmentStatus @default(SCHEDULED)
  // Preenchido quando o agendamento foi gerado por uma recorrência.
  recurringAppointmentId String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime?

  company              Company               @relation(fields: [companyId], references: [id])
  client               People                @relation("AppointmentClient", fields: [clientId], references: [id])
  professional         People                @relation("AppointmentProfessional", fields: [professionalId], references: [id])
  service              Service               @relation(fields: [serviceId], references: [id])
  payment              Payment?
  recurringAppointment RecurringAppointment? @relation(fields: [recurringAppointmentId], references: [id])

  @@index([companyId, startAt])
  @@index([professionalId, startAt])
  @@index([clientId, startAt])
  @@index([status, endAt])
  @@index([serviceId])
  @@index([recurringAppointmentId])
  @@map("appointments")
}

// Sem deletedAt por decisão do domínio: não há exclusão, apenas isActive.
model RecurringAppointment {
  id             String    @id @default(uuid())
  companyId      String
  clientId       String
  professionalId String
  serviceId      String
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  note           String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  company       Company        @relation(fields: [companyId], references: [id])
  client        People         @relation("RecurringAppointmentClient", fields: [clientId], references: [id])
  professional  People         @relation("RecurringAppointmentProfessional", fields: [professionalId], references: [id])
  service       Service        @relation(fields: [serviceId], references: [id])
  days          RecurringDay[]
  appointments  Appointment[]

  @@index([companyId, isActive])
  @@index([professionalId])
  @@index([clientId])
  @@index([serviceId])
  @@map("recurring_appointments")
}

// Pacote de serviços vendido pela empresa. O valor mensal é definido pela empresa;
// os períodos de contratação (PlanPeriod) aplicam descontos sobre ele. Não há
// exclusão: o plano é desativado por isActive.
model Plan {
  id             String    @id @default(uuid())
  companyId      String
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  description    String?
  monthlyPrice   Decimal   @db.Decimal(10, 2)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  company Company      @relation(fields: [companyId], references: [id])
  items   PlanItem[]
  periods PlanPeriod[]

  @@unique([companyId, name])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("plans")
}

// Serviço incluído em um plano. Faz parte do plano: é criado e substituído junto
// com ele, por isso usa exclusão física (ver docs/database.md).
model PlanItem {
  id        String   @id @default(uuid())
  planId    String
  serviceId String
  createdAt DateTime @default(now())

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([planId, serviceId])
  @@index([serviceId])
  @@map("plan_items")
}

// Período de contratação de um plano, com os dois percentuais de desconto. Faz
// parte do plano (exclusão física); as contratações guardam cópia dos valores.
model PlanPeriod {
  id                     String    @id @default(uuid())
  planId                 String
  months                 Int
  // Desconto para pagamento integral do período.
  discountPercent        Decimal   @db.Decimal(5, 2)
  // Desconto de cada parcela no pagamento mensal.
  monthlyDiscountPercent Decimal   @db.Decimal(5, 2)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, months])
  @@map("plan_periods")
}

// Faz parte do agendamento recorrente: é criada e substituída junto com ele,
// por isso usa exclusão física (ver docs/database.md).
model RecurringDay {
  id                     String    @id @default(uuid())
  recurringAppointmentId String
  weekDay                WeekDay
  startTime              DateTime  @db.Time(0)
  endTime                DateTime  @db.Time(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime?

  recurringAppointment RecurringAppointment @relation(fields: [recurringAppointmentId], references: [id], onDelete: Cascade)

  @@index([recurringAppointmentId])
  @@map("recurring_days")
}

model PaymentMethod {
  id             String    @id @default(uuid())
  name           String
  // Nome sem acentos e em minúsculas, mantido pela aplicação para a busca (ver normalizeForSearch).
  normalizedName String
  companyId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?

  company  Company   @relation(fields: [companyId], references: [id])
  payments Payment[]

  @@unique([companyId, name], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("payment_methods")
}

model Payment {
  id              String        @id @default(uuid())
  // A empresa fica no próprio pagamento: os de plano não têm agendamento.
  companyId       String
  // Nulo nos pagamentos de contratação de plano (a partir da Etapa 6 do roadmap).
  appointmentId   String?
  amount          Decimal       @db.Decimal(10, 2)
  // Vencimento pelo calendário, opcional. Em agendamentos de recorrência, acompanha a data do agendamento.
  dueDate         DateTime?     @db.Date
  // Preenchido apenas quando o pagamento está PAID.
  paidAt          DateTime?
  // Opcional enquanto PENDING: o método é informado na baixa para PAID.
  paymentMethodId String?
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime?
  deletedAt       DateTime?

  company       Company       @relation(fields: [companyId], references: [id])
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  // Parcial: um pagamento excluído libera o agendamento para um novo pagamento.
  @@unique([appointmentId], where: raw("\"deletedAt\" IS NULL"))
  @@index([companyId])
  @@index([paymentMethodId])
  @@map("payments")
}

// Janela de atendimento de uma empresa em um dia da semana. Uma empresa pode ter
// mais de uma janela no mesmo dia (ex.: manhã e tarde). Empresa sem nenhuma
// janela cadastrada não restringe horários (ver docs/business-rules.md).
model BusinessHour {
  id        String    @id @default(uuid())
  companyId String
  weekDay   WeekDay
  openAt    DateTime  @db.Time(0)
  closeAt   DateTime  @db.Time(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, weekDay])
  @@map("business_hours")
}

/**
 * Aviso para a empresa agir. Ainda não há tipos em uso: a entidade é mantida para
 * implementações futuras. Notificações não são excluídas: são resolvidas (ver docs/database.md).
 */
model Notification {
  id         String    @id @default(uuid())
  companyId  String
  message    String
  readAt     DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, resolvedAt])
  @@map("notifications")
}
